{
  "personalInfo": {
    "slug": "personal-info",
    "title": "Personal Information",
    "desc": "Please select the option that applies to you or supply the needed information as completely as possible.",
    "questions": [
      {
        "group": "name",
        "label": "Name:",
        "fields": [
          {
            "id": "first_name",
            "type": "text",
            "placeholder": "Firstname",
            "validation": "required|string|min:2|max:50"
          },
          {
            "id": "middle_name",
            "type": "text",
            "placeholder": "Middlename",
            "validation": "required|string|min:2|max:50"
          },
          {
            "id": "last_name",
            "type": "text",
            "placeholder": "Lastname",
            "validation": "required|string|min:2|max:50"
          }
        ]
      },
      {
        "group": "contact",
        "fields": [
          {
            "id": "address",
            "label": "Home Address:",
            "type": "text",
            "placeholder": "Address",
            "validation": "required|string|max:255"
          },
          {
            "id": "email",
            "label": "Email Address",
            "type": "text",
            "placeholder": "Email",
            "validation": "required|email"
          },
          {
            "id": "contact",
            "label": "Mobile Number:",
            "type": "tel",
            "placeholder": "Mobile Number",
            "validation": "required|digits:11"
          }
        ]
      },
      {
        "group": "education",
        "fields": [
          {
            "id": "degree",
            "label": "Bachelors Degree Obtained from WUP:",
            "type": "select",
            "placeholder": "Choose from the following choices",
            "options": [
              {
                "label": "Bachelor of Science in Computer Engineering",
                "value": "bscpe"
              },
              {
                "label": "Bachelor of Science in Electronic Engineering",
                "value": "bsece"
              },
              {
                "label": "Bachelor of Science in Information Technology",
                "value": "bsit"
              }
            ],
            "validation": "required"
          },
          {
            "id": "year_graduated",
            "label": "Year Graduated:",
            "type": "year_select",
            "placeholder": "YYYY",
            "min": 1990,
            "max": 2025,
            "validation": "required|digits:4"
          }
        ]
      }
    ]
  },
  "employmentStatus": {
    "slug": "employment-status",
    "title": "Employment Status",
    "desc": "Please select the option that applies to you or supply the needed information as completely as possible.",
    "questions": [
      {
        "id": "continuing_education",
        "label": "What continuing professional education were/are you engaged in:",
        "type": "radio",
        "options": [
          {
            "label": "Graduate Study",
            "value": "graduate_study"
          },
          {
            "label": "Attending seminars/trainings",
            "value": "seminars_trainings"
          },
          {
            "label": "Others (please specify):",
            "value": "others"
          }
        ],
        "validation": "required"
      },
      {
        "id": "is_employed",
        "label": "Are you currently employed?",
        "type": "radio",
        "options": [
          {
            "label": "Yes",
            "value": "yes"
          },
          {
            "label": "No",
            "value": "no"
          }
        ],
        "validation": "required"
      },
      {
        "id": "employment_status",
        "label": "Employment Status",
        "type": "radio",
        "options": [
          {
            "label": "Permanent/Regular",
            "value": "permanent"
          },
          {
            "label": "Probationary",
            "value": "probationary"
          }
        ],
        "validation": "required_if:is_employed,yes"
      },
      {
        "id": "company_name",
        "label": "Name of Company/Institution of current employment:",
        "type": "text",
        "placeholder": "Company/Institution",
        "validation": "required_if:is_employed,yes"
      },
      {
        "id": "nature_of_company",
        "label": "Nature of Company:",
        "type": "text",
        "placeholder": "e.g. Software Development, IT Support, Networking",
        "validation": "required_if:is_employed,yes"
      },
      {
        "id": "monthly_salary",
        "label": "Monthly Salary (please specify):",
        "type": "text",
        "placeholder": "e.g. ₱20,000",
        "validation": "required_if:is_employed,yes"
      }
    ]
  },
  "employmentHistory": {
    "slug": "employment-history",
    "title": "Employment History",
    "desc": "Please select the option that applies to you or supply the needed information as completely as possible.",
    "questions": [
      {
        "id": "company_name",
        "label": "Name of Company:",
        "type": "text",
        "placeholder": "Company/Employer Name",
        "validation": "required|string|max:255"
      },
      {
        "id": "position",
        "label": "Position:",
        "type": "text",
        "placeholder": "Position",
        "validation": "required|string|max:100"
      },
      {
        "id": "duration_of_stay",
        "label": "Duration of stay:",
        "type": "text",
        "placeholder": "e.g. 6 months, 3 years",
        "validation": "required|string|max:100"
      },
      {
        "id": "first_job_source",
        "label": "How did you find your first job?",
        "type": "radio_grid",
        "options": [
          {
            "label": "Response to advertisements",
            "value": "advertisements"
          },
          {
            "label": "Information from friends",
            "value": "friends"
          },
          {
            "label": "Recommended by someone",
            "value": "recommended"
          },
          {
            "label": "Job Fair",
            "value": "job_fair"
          },
          {
            "label": "Walk-in applicant",
            "value": "walk_in"
          },
          {
            "label": "University job placement",
            "value": "university_placement"
          },
          {
            "label": "Others (please specify):",
            "value": "others"
          }
        ],
        "validation": "required"
      },
      {
        "id": "job_hunting_problems",
        "label": "What problems did you encounter during your job hunting?",
        "type": "text",
        "placeholder": "e.g. No job openings",
        "validation": "required|string|max:255"
      },
      {
        "id": "suggestions",
        "label": "What are your suggestions to enhance the competitiveness of WUP graduates? Feel free to specify some areas that you believe needs to be improved?",
        "type": "text",
        "placeholder": "e.g. More training on soft skills",
        "validation": "required|string|max:500"
      },
      {
        "id": "is_in_business",
        "label": "If not employed, are you engaged in any business",
        "type": "radio",
        "options": [
          {
            "label": "Yes",
            "value": "yes"
          },
          {
            "label": "No",
            "value": "no"
          }
        ],
        "validation": "required"
      },
      {
        "id": "nature_of_business",
        "label": "Nature of Business:",
        "type": "text",
        "placeholder": "e.g. BPO, Systems Integration,",
        "validation": "nullable|string|max:255"
      },
      {
        "id": "community_projects",
        "label": "What community projects were/are you involved in?",
        "type": "radio_grid",
        "options": [
          {
            "label": "Medical/Dental mission",
            "value": "medical_dental"
          },
          {
            "label": "Conducting training",
            "value": "conducting_training"
          },
          {
            "label": "Livelihood projects",
            "value": "livelihood"
          },
          {
            "label": "Others (please specify)",
            "value": "others"
          }
        ],
        "validation": "required"
      }
    ]
  },
